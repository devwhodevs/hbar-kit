{
  "name": "@hbar-kit/payments",
  "version": "0.1.0",
  "description": "Business-level HBAR/HTS payment verification on top of @hbar-kit/mirror.",
  "license": "MIT",
  "homepage": "https://devwhodevs.github.io/hbar-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devwhodevs/hbar-kit.git",
    "directory": "packages/payments"
  },
  "bugs": "https://github.com/devwhodevs/hbar-kit/issues",
  "keywords": [
    "hedera",
    "hbar",
    "hts",
    "payments",
    "payment-verification",
    "mirror-node",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:publish": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@hbar-kit/core": "workspace:*",
    "@hbar-kit/mirror": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
