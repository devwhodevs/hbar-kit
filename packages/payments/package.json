{
  "name": "@hbar-kit/payments",
  "version": "0.0.0",
  "description": "Business-level HBAR/HTS payment verification on top of @hbar-kit/mirror.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src", "!src/**/*.test.ts"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:publish": "publint --strict && attw --pack ."
  },
  "dependencies": { "@hbar-kit/core": "workspace:*", "@hbar-kit/mirror": "workspace:*" },
  "devDependencies": { "typescript": "catalog:", "vitest": "catalog:" },
  "publishConfig": { "access": "public" }
}
